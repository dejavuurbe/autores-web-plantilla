---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
import { personSchema, bookSchema } from '../core/schema';
---
<BaseLayout
  title={`${site.name} | ${site.role}`}
  description={site.description}
  schema={[personSchema(), bookSchema()]}
>
  <section class="hero section" id="inicio">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{site.role}</p>
        <h1>{site.name}</h1>
        <p class="lead">{site.tagline}</p>
        <div class="actions">
          <a class="button secondary" href="#obra">Conocer la obra</a>
        </div>
      </div>
      <img
        class="portrait"
        src={site.author.photo}
        alt={`Retrato de ${site.name}`}
        width="700"
        height="820"
      />
    </div>
  </section>

  <section class="section book-section" id="obra">
    <div class="container grid-two">
      <img
        class="cover"
        src={site.featuredBook.cover}
        alt={`Portada de ${site.featuredBook.title}`}
        width="520"
        height="780"
      />
      <div>
        <p class="eyebrow">Obra</p>
        <h2>{site.featuredBook.title}</h2>
        {site.featuredBook.subtitle && <p class="book-subtitle">{site.featuredBook.subtitle}</p>}
        <p class="lead">{site.featuredBook.synopsis}</p>

        {site.featuredBook.buyUrl && (
          <div class="purchase">
            <a
              class="button"
              href={site.featuredBook.buyUrl}
              target="_blank"
              rel="noopener"
            >
              {site.featuredBook.buyLabel || 'Adquirí tu ejemplar'}
            </a>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section" id="autor">
    <div class="container bio-grid">
      <div>
        <p class="eyebrow">Biografía</p>
        <h2>Sobre {site.name}</h2>
      </div>
      <p class="lead">{site.author.longBio}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-top: clamp(3rem, 8vw, 8rem); }
  .hero-grid {
    display: grid;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .portrait {
    width: 100%;
    max-height: 680px;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .actions {
    display: flex;
    gap: .75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .book-section { background: var(--color-surface); }
  .cover {
    max-width: 360px;
    margin-inline: auto;
    border-radius: 8px;
    box-shadow: var(--shadow);
  }
  .book-subtitle {
    margin: -.25rem 0 1rem;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 1.35rem;
  }
  .purchase { margin-top: 2rem; }
  .bio-grid {
    display: grid;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  @media (min-width: 850px) {
    .hero-grid { grid-template-columns: 1.2fr .8fr; }
    .bio-grid { grid-template-columns: .8fr 1.2fr; }
  }
</style>
