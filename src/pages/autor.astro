---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL('/autor/', site.url).href,
  description: site.author.longBio,
};
---
<BaseLayout
  title={`Sobre ${site.name} | ${site.role}`}
  description={site.author.shortBio}
  schema={schema}
>
  <section class="section">
    <div class="container grid-two">
      <img
        src={site.author.photo}
        alt={`Retrato de ${site.name}`}
        width="700"
        height="820"
      />
      <div>
        <p class="eyebrow">Autor</p>
        <h1>{site.name}</h1>
        <p class="lead">{site.author.longBio}</p>
      </div>
    </div>
  </section>
</BaseLayout>
