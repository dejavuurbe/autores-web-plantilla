---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
---
<BaseLayout
  title={`Actividad y contacto | ${site.name}`}
  description={`Actividad literaria y canales públicos de ${site.name}.`}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Actividad</p>
      <h1>Presentaciones y recorrido público</h1>
      <p class="lead">
        Actividades, entrevistas, notas y apariciones verificables vinculadas con el autor y su obra.
      </p>

      <div class="press-grid">
        {site.press.map((item) => (
          <article class="card">
            <p class="eyebrow">{item.source}</p>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
            {item.url && (
              <a href={item.url} target="_blank" rel="noopener">
                Ver fuente
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section contact-section" id="contacto">
    <div class="container">
      <p class="eyebrow">Contacto</p>
      <h2>Canales públicos</h2>
      <p class="lead">
        Redes y medios oficiales para lectores, prensa, entrevistas, presentaciones y consultas.
      </p>

      <div class="contact-links">
        {site.social.filter((item) => item.url).map((item) => (
          <a class="button secondary" href={item.url} target="_blank" rel="me noopener">
            {item.label}
          </a>
        ))}
        {site.email && <a class="button" href={`mailto:${site.email}`}>{site.email}</a>}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 { max-width: 15ch; }
  .press-grid {
    display: grid;
    gap: 1rem;
    margin-top: 3rem;
  }
  .press-grid h2 { font-size: 2rem; }
  .contact-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: .8rem;
    margin-top: 2rem;
  }
  @media (min-width: 760px) {
    .press-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
