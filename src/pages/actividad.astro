---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { site } from '../content/site';
const socials = site.social.filter((item) => item.state !== 'omitted');
const emailActive = site.emailState === 'confirmed' && Boolean(site.email);
const emailPending = site.emailState === 'pending';
---
<BaseLayout title={`Actividad y contacto | ${site.name}`} description={`Actividad literaria y canales públicos de ${site.name}.`}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Actividad</p>
      <h1>Presentaciones y recorrido público</h1>
      <p class="lead">Actividades, entrevistas, notas y apariciones verificables vinculadas con el autor y su obra.</p>
      {site.activity.length > 0
        ? <div class="press-grid">{site.activity.map((item) => (
            <article class="card"><p class="eyebrow">{item.source}</p><h2>{item.title}</h2><p>{item.description}</p>{item.url && /^https?:\/\//.test(item.url) && <a href={item.url} target="_blank" rel="noopener">Ver fuente</a>}</article>
          ))}</div>
        : site.activityState === 'pending'
          ? <article class="card pending-card"><p class="eyebrow">Pendiente</p><h2>Actividad para confirmar</h2><p>Aún no hay hitos verificados y aprobados para mostrar.</p></article>
          : null}
    </div>
  </section>

  <section class="section contact-section" id="contacto">
    <div class="container">
      <p class="eyebrow">Contacto</p><h2>Canales públicos</h2>
      <p class="lead">Redes y medios oficiales para lectores, prensa, entrevistas, presentaciones y consultas.</p>
      <div class="contact-links">
        {socials.map((item) => {
          const active = item.state === 'confirmed' && Boolean(item.url) && /^https?:\/\//.test(item.url!);
          return active
            ? <a class="social-link" href={item.url} target="_blank" rel="me noopener"><SocialIcon platform={item.platform} /><span>{item.label}</span></a>
            : <span class="social-link pending" aria-label={`${item.label}: Pendiente, enlace no confirmado`}><SocialIcon platform={item.platform} /><span>{item.label}</span><small>Pendiente</small></span>;
        })}
        {emailActive && <a class="button" href={`mailto:${site.email}`}>{site.email}</a>}
        {emailPending && <span class="social-link pending"><span>Correo electrónico</span><small>Pendiente</small></span>}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1{max-width:15ch}
  .press-grid{display:grid;gap:1rem;margin-top:3rem}
  .press-grid h2{font-size:2rem}
  .pending-card{border-style:dashed}
  .contact-section{background:var(--color-surface);border-top:1px solid var(--color-border)}
  .contact-links{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2rem}
  .social-link{display:inline-flex;align-items:center;gap:.55rem;min-height:46px;padding:.65rem 1rem;border:1px solid var(--color-border);border-radius:999px;text-decoration:none}
  .social-link.pending{border-style:dashed;color:var(--color-muted);cursor:default}
  .social-link small{font-size:.7rem;text-transform:uppercase;letter-spacing:.06em}
  @media(min-width:760px){.press-grid{grid-template-columns:repeat(2,1fr)}}
</style>
