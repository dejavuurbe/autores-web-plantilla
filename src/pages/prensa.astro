---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
---
<BaseLayout
  title={`Prensa y actividad | ${site.name}`}
  description={`Entrevistas, notas y actividad cultural de ${site.name}.`}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Prensa y actividad</p>
      <h1>Notas, entrevistas y apariciones</h1>
      <p class="lead">
        Espacio para reunir fuentes externas verificables y facilitar el trabajo de lectores,
        periodistas, bibliotecas y organizadores.
      </p>
      <div class="press-grid">
        {site.press.map((item) => (
          <article class="card">
            <p class="eyebrow">{item.source}</p>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
            <a href={item.url}>Ver fuente</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 { max-width: 15ch; }
  .press-grid {
    display: grid;
    gap: 1rem;
    margin-top: 3rem;
  }
  .press-grid h2 { font-size: 2rem; }
  @media (min-width: 760px) {
    .press-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
