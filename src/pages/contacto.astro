---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
---
<BaseLayout
  title={`Contacto | ${site.name}`}
  description={`Contacto oficial de ${site.name} para lectores, prensa y actividad cultural.`}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Contacto</p>
      <h1>Contacto oficial</h1>
      <p class="lead">
        Para prensa, entrevistas, encuentros de lectura, presentaciones y consultas relacionadas
        con la obra.
      </p>
      <p><a class="button" href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </section>
</BaseLayout>
