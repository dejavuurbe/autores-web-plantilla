---
import { site } from '../content/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-client">
    <div>
      <strong>{site.name}</strong>
      <p>{site.footerLine}</p>
    </div>
    <div class="links">
      {site.social.filter((item) => item.url && item.url !== "#").map((item) => <a href={item.url} target="_blank" rel="me noopener">{item.label}</a>)}
      {site.email && <a href={`mailto:${site.email}`}>Contacto</a>}
    </div>
  </div>

  <div class="container footer-bottom">
    <div class="legal">© {year} {site.name}</div>

    {site.credit.enabled && (
      <a
        class="studio-credit"
        href={site.credit.url}
        aria-label={`${site.credit.label}. Conocer el proyecto`}
      >
        <span>{site.credit.label}</span>
        <span class="studio-mark" aria-hidden="true"></span>
      </a>
    )}
  </div>
</footer>

<style>
  .site-footer {
    padding: 3rem 0 1.4rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-client {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .footer-client strong {
    font-family: var(--font-display);
  }

  .footer-client p,
  .legal {
    color: var(--color-muted);
  }

  .footer-client p {
    margin: .55rem 0 0;
  }

  .links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem 2rem;
    flex-wrap: wrap;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-border) 68%, transparent);
  }

  .legal {
    font-size: .85rem;
  }

  .studio-credit {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    color: var(--color-muted);
    font-size: .72rem;
    letter-spacing: .035em;
    text-decoration: none;
    white-space: nowrap;
  }

  .studio-credit:hover,
  .studio-credit:focus-visible {
    color: var(--color-accent);
  }

  .studio-mark {
    width: 27px;
    height: 27px;
    flex: 0 0 27px;
    background: currentColor;
    -webkit-mask: url("data:image/png;base64,") center / contain no-repeat;
    mask: url("data:image/png;base64,") center / contain no-repeat;
  }

  @media (max-width: 620px) {
    .site-footer {
      padding-top: 2.5rem;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .studio-credit {
      white-space: normal;
    }
  }
</style>
